{
  "name": "sweater-vest",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "release",
    "release/vscode-extension",
    "suede.nests.sweater-vest",
    "suede.nests.sweater-vest/vscode-extension"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run",
    "report": "node release/report/index.ts",
    "doc": "npx @p-buddy/parkdown@0.0.32",
    "undoc": "npx @p-buddy/parkdown@0.0.32 --depopulate --no-inclusions"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.22",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@vitest/browser-playwright": "^5.0.3",
    "acorn": "^8.18.0",
    "jsdom": "^30.1.1",
    "svelte-check": "^4.7.6",
    "vite": "^7.3.6",
    "vitest": "^5.0.3",
    "vitest-browser-svelte": "^3.1.0"
  },
  "dependencies": {
    "@types/node": "^25.9.9",
    "svelte": "^5.57.1",
    "typescript": "~5.9.3"
  }
}
